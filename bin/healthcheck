#!/usr/bin/env php
<?php
/**
 * Weatherdata - Anschluss an den LoxBerry-Healthcheck (Bauart Audioserver NG).
 *
 * LoxBerry ruft bin/healthcheck als loxberry auf - einmal mit 'title', einmal mit 'check'. Antwort: JSON mit desc,
 * status, result, logfile; Status 3 Fehler, 4 Warnung, 5 in Ordnung, 6 Hinweis. NUR AUS DATEIEN: kein Netz, keine
 * Selbstheilung, nichts angelegt. Die Stufen rechnet wd_gesundheit(). Standort und Warnzelle stehen nie in der Antwort.
 */
error_reporting(E_ALL & ~E_DEPRECATED & ~E_NOTICE);
ini_set('display_errors', '0');

$wd_was = isset($argv[1]) ? strtolower((string) $argv[1]) : 'check';
if ($wd_was === 'title') {
    echo "Weatherdata\n";
    exit(0);
}
if (basename(dirname(__DIR__)) === 'plugins' && basename(dirname(dirname(__DIR__))) === 'bin') {
    $wd_lib = dirname(dirname(dirname(__DIR__))) . '/webfrontend/html/plugins/' . basename(__DIR__) . '/wd_lib.php';
} else {
    $wd_lib = dirname(__DIR__) . '/webfrontend/html/wd_lib.php';
}
if (!is_file($wd_lib)) {
    echo json_encode(array('desc' => 'Weatherdata', 'status' => 3,
        'result' => 'Die Bibliothek wd_lib.php wurde nicht gefunden - das Plugin ist unvollstaendig installiert.')) . "\n";
    exit(0);
}
require_once $wd_lib;
list($wd_status, $wd_text) = wd_gesundheit();
echo json_encode(array(
    'desc'    => 'Weatherdata',
    'status'  => (int) $wd_status,
    'result'  => (string) $wd_text,
    'logfile' => (string) wd_paths()['log'],
), JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n";
exit(0);
