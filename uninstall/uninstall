#!/bin/bash
if [ -n "$2" ] && [ "$2" != "weatherdata" ]; then
    echo "<INFO> Deinstallation von '$2' - dieses Skript gehoert zu 'weatherdata' und tut nichts."
    exit 0
fi
UN_FOLDER="${3:-weatherdata}"
UN_BASE="${5:-$LBHOMEDIR}"
case "$UN_FOLDER" in
    ''|*/*|*..*) echo "<FAIL> Unzulaessiger Ordnername '$UN_FOLDER' - nichts geloescht."; exit 1 ;;
esac
if [ -z "$UN_BASE" ] || [ ! -d "$UN_BASE/config/plugins" ] || [ ! -d "$UN_BASE/data/plugins" ] \
   || [ ! -f "$UN_BASE/config/system/general.json" ]; then
    echo "<FAIL> '$UN_BASE' sieht nicht wie ein LoxBerry aus (config/plugins, data/plugins und"
    echo "<FAIL> config/system/general.json muessen dort liegen) - es wurde nichts geloescht."
    echo "<FAIL> Bitte von Hand nachsehen: config/plugins/$UN_FOLDER.backup.json, data/plugins/$UN_FOLDER.upgrade_*"
    exit 1
fi
# Das einzige zurueckbehaltene Thema (fassung) abraeumen; Praefix aus der Konfiguration oder der Zweitschrift, leere Nutzlast loescht es.
# Das Gateway verliert unter Last Datagramme (am Geraet 3 von 10 angekommen, Regeln/07): einmal senden reicht nicht.
UN_PHP=$(command -v php)
if [ -n "$UN_PHP" ]; then
    "$UN_PHP" -r '$c = json_decode((string) @file_get_contents($argv[1]), true); $g = json_decode((string) @file_get_contents($argv[2]), true);
        if (!is_array($c) || !isset($c["mqtt_topic"])) { $c = json_decode((string) @file_get_contents($argv[3]), true); }
        $pf = (is_array($c) && isset($c["mqtt_topic"]) && is_string($c["mqtt_topic"]) && preg_match("#^[A-Za-z0-9_/-]+$#", $c["mqtt_topic"])) ? $c["mqtt_topic"] : "weatherdata";
        $port = is_array($g) && isset($g["Mqtt"]["Udpinport"]) ? (int) $g["Mqtt"]["Udpinport"] : 0;
        if ($port > 0) { $s = @stream_socket_client("udp://127.0.0.1:" . $port, $e, $t, 1); if ($s) { for ($i = 0; $i < 10; $i++) { @fwrite($s, "retain " . $pf . "/fassung "); usleep(200000); } fclose($s); } }' -- "$UN_BASE/config/plugins/$UN_FOLDER/weatherdata.json" "$UN_BASE/config/system/general.json" "$UN_BASE/config/plugins/$UN_FOLDER.backup.json" 2>/dev/null
fi
# 0.9.8: die 26 (ab 0.9.13: 27, dazu haus/wetter/datum_text) zurueckbehaltenen Hausthemen haus/wetter/... (0.9.10: dazu die 12 von haus/pv/...) abraeumen (mit Ruecklesen am Broker) - nur, wenn diese Installation
# Anbieter ist oder war (Haken haus_wetter_ein oder Merker _haus_frueher); eine Zweitinstallation raeumt die Themen der ersten nie ab.
# wd_takt.php gibt <OK>/<INFO>/<WARNING> aus und endet immer mit 0; die Deinstallation laeuft weiter.
UN_TAKT="$UN_BASE/bin/plugins/$UN_FOLDER/wd_takt.php"
if [ -f "$UN_TAKT" ] && command -v php >/dev/null 2>&1; then
    timeout -k 5 90 php "$UN_TAKT" --haus-leeren 2>&1 | head -n 10     # 0.9.10: auch haus/pv
fi
# Port 6066 des Emulators: nur die eigene Datei, nur wenn sie da ist. Die Deinstallation laeuft als root.
UN_ETC="${WD_APACHE_ETC:-/etc/apache2}"
UN_NAME="001-$UN_FOLDER-emu"
if [ -e "$UN_ETC/sites-available/$UN_NAME.conf" ] || [ -e "$UN_ETC/sites-enabled/$UN_NAME.conf" ]; then
    a2dissite "$UN_NAME" >/dev/null 2>&1
    rm -f "$UN_ETC/sites-enabled/$UN_NAME.conf" "$UN_ETC/sites-available/$UN_NAME.conf"
    if [ -e "$UN_ETC/sites-available/$UN_NAME.conf" ] || [ -e "$UN_ETC/sites-enabled/$UN_NAME.conf" ]; then
        echo "<WARNING> Port 6066 des Emulators liess sich nicht austragen, bitte von Hand entfernen: $UN_ETC/sites-available/$UN_NAME.conf"
    elif apache2ctl graceful >/dev/null 2>&1; then
        echo "<OK> Port 6066 des Emulators ausgetragen, Apache neu geladen."
    else
        echo "<WARNING> Port 6066 des Emulators ausgetragen, der Apache liess sich aber nicht neu laden."
    fi
fi
UID_LB=$(id -u loxberry 2>/dev/null || id -u)
ZIELE="$UN_BASE/config/plugins/$UN_FOLDER.backup.json
$UN_BASE/config/plugins/$UN_FOLDER.backup.json.alt
$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung
$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung.neu
$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung.alt
$UN_BASE/data/plugins/$UN_FOLDER.upgrade_laeuft
/tmp/$UN_FOLDER
/tmp/$UN_FOLDER-$UID_LB
/tmp/$UN_FOLDER-eigen"
printf '%s\n' "$ZIELE" | while IFS= read -r Z; do
    [ -n "$Z" ] || continue
    if [ -e "$Z" ] || [ -L "$Z" ]; then
        rm -rf "${Z:?}" 2>/dev/null
    fi
done
UEBRIG=""
while IFS= read -r Z; do
    [ -n "$Z" ] || continue
    if [ -e "$Z" ] || [ -L "$Z" ]; then UEBRIG="$UEBRIG $Z"; fi
done <<EOF_ZIELE
$ZIELE
EOF_ZIELE
if [ -z "$UEBRIG" ]; then
    echo "<OK> Zweitschrift, Update-Sicherung, beiseitegelegte Staende, Marke und Zwischenordner entfernt (nachgezaehlt: nichts mehr da)."
    exit 0
fi
echo "<FAIL> Es liegen noch Dateien dieses Plugins neben den Plugin-Ordnern - bitte von Hand entfernen (die Zweitschrift traegt das Aktionstoken):"
for Z in $UEBRIG; do echo "<FAIL>   $Z"; done
exit 1
